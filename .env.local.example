# Copiá este archivo a .env.local (no lo subas al repo) y completá con tus datos reales.

# Access Token de Mercado Pago (Panel de desarrolladores > Tus integraciones > Credenciales).
# Empezá con las credenciales de PRUEBA (test) para probar el flujo completo,
# y recién pasá a las de PRODUCCIÓN cuando esté todo validado.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública del sitio (usada para armar los back_urls de Mercado Pago).
# En local: http://localhost:3000
# En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
